        "parameters": [
          {
            "name": "project_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "项目号，如 PRJ-IND-001",
              "title": "Project Code"
            },
            "description": "项目号，如 PRJ-IND-001"
          },
          {
            "name": "sample_desc",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "现场画面文本描述，如『摄像头 C07 画面：3 名作业人员未戴安全帽通过 2#塔吊下方作业区』",
