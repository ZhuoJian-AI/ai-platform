{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhuojian.ai/schemas/ai-platform-extension.json",
  "title": "AI Platform Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "version", "type", "layer", "operation", "entry"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": { "enum": ["runtime_plugin", "system_tool"] },
    "layer": { "enum": ["coordinator", "runtime", "memory_context", "rag_strategy", "system_tool", "model_adapter", "hook_guard", "skill_mcp", "ui_plugin", "library", "unknown"] },
    "operation": { "enum": ["add", "replace"] },
    "entry": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
    "export_name": { "type": "string", "default": "default" },
    "provides": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dsh_version": { "type": "string" },
    "config_schema": { "type": "object" },
    "default_config": { "type": "object" },
    "platform_adapted": { "type": "boolean", "default": false },
    "health_check": { "type": ["string", "object", "null"] },
    "smoke_test": { "type": ["string", "object", "null"] },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "input_schema", "risk_level", "side_effects"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "input_schema": { "type": "object" },
          "risk_level": { "enum": ["low", "medium", "high"] },
          "side_effects": { "type": "boolean" },
          "required_platform_capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
