ARG AI_PLATFORM_SKILL_RUNNER_DEPS_BASE
FROM ${AI_PLATFORM_SKILL_RUNNER_DEPS_BASE}

ARG SOURCE_COMMIT=unknown
ARG SOURCE_REPOSITORY=https://github.com/ZhuoJian-AI/ai-platform
ENV SOURCE_COMMIT=${SOURCE_COMMIT}
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} \
      org.opencontainers.image.source=${SOURCE_REPOSITORY}

WORKDIR /app
COPY app.py .
COPY builtin_tools.py .
COPY --chmod=755 entrypoint.sh /usr/local/bin/skill-runner-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/skill-runner-entrypoint

EXPOSE 8020
ENTRYPOINT ["/usr/local/bin/skill-runner-entrypoint"]
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8020"]
