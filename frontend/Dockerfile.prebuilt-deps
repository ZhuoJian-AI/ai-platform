ARG AI_PLATFORM_FRONTEND_DEPS_BASE
ARG AI_PLATFORM_NGINX_BASE=nginx:1.27-alpine
FROM ${AI_PLATFORM_FRONTEND_DEPS_BASE} AS builder

WORKDIR /app
COPY . .
RUN npm run build

FROM ${AI_PLATFORM_NGINX_BASE}
COPY nginx.coolify.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -qO- http://127.0.0.1/health > /dev/null
CMD ["nginx", "-g", "daemon off;"]
