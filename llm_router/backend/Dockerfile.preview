FROM python:3.12-slim

ARG SOURCE_COMMIT=unknown
ARG SOURCE_REPOSITORY=https://github.com/ZhuoJian-AI/ai-platform
ENV SOURCE_COMMIT=${SOURCE_COMMIT}
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} \
      org.opencontainers.image.source=${SOURCE_REPOSITORY}

WORKDIR /app

ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PYTHONPATH=/app

# LibreOffice is intentionally isolated in this worker image. The API image
# remains small and never performs synchronous Office conversion.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-core \
        libreoffice-writer \
        libreoffice-calc \
        libreoffice-impress \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN python -m pip install --no-cache-dir --retries 10 --timeout 120 -e ".[dev]"

COPY . .

CMD ["python", "-m", "app.workers.workspace_preview"]
