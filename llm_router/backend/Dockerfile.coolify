ARG AI_PLATFORM_BACKEND_DEPS_BASE
FROM ${AI_PLATFORM_BACKEND_DEPS_BASE}

ARG SOURCE_COMMIT=unknown
ARG SOURCE_REPOSITORY=https://github.com/ZhuoJian-AI/ai-platform
ENV SOURCE_COMMIT=${SOURCE_COMMIT}
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} \
      org.opencontainers.image.source=${SOURCE_REPOSITORY}

RUN rm -rf /app && mkdir -p /app
WORKDIR /app

# Multimodal audio jobs normalize browser uploads before provider calls.
# Keep this in the Registry-first runtime image as well as the local Dockerfile.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY . .

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
