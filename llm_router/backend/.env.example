# LLM Router Environment Variables

# Application
APP_NAME=LLM Router
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-strong-random-key
MASTER_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded-key

# Database
DATABASE_URL=postgresql+asyncpg://ai_infra:ai_infra@localhost:5432/ai_infra

# Redis
REDIS_URL=redis://localhost:6379/0

# API Key cache TTL (seconds)
API_KEY_CACHE_TTL=60

# DLP Stream Scanner
DLP_STREAM_BUFFER_WINDOW=4096
DLP_STREAM_FLUSH_TIMEOUT_MS=200
