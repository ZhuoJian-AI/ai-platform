# LLM Router Environment Variables

# Application
APP_NAME=LLM Router
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-strong-random-key
MASTER_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded-key

# Database
DATABASE_URL=postgresql+asyncpg://ai_infra:ai_infra@localhost:5432/ai_infra

# Redis
REDIS_URL=redis://localhost:6379/0

# API Key cache TTL (seconds)
API_KEY_CACHE_TTL=60

# DLP Stream Scanner
DLP_STREAM_BUFFER_WINDOW=4096
DLP_STREAM_FLUSH_TIMEOUT_MS=200

# Executable Agent Skills
CODE_SKILLS_ENABLED=false
# Empty enables every organization; staging can use a comma-separated allowlist.
AGENT_SKILLS_ORG_ALLOWLIST=
SKILL_RUNNER_URL=http://localhost:8020
SKILL_RUNNER_TOKEN=skill-runner-dev-token-change-in-production
SKILL_RUNNER_TIMEOUT_SECONDS=120

# Authenticated original Office/PDF previews. Empty allowlist enables all orgs.
ORIGINAL_PREVIEW_ENABLED=false
ORIGINAL_PREVIEW_ORG_ALLOWLIST=
ORIGINAL_PREVIEW_CACHE_ROOT=/preview-cache

# Workspace binary object storage through ZhuoJian Storage Gateway.
# Keep disabled for local-only development. STORAGE_PROJECT_TOKEN is issued
# per GitHub project by the platform provisioner; never place an OSS AccessKey here.
WORKSPACE_OBJECT_STORAGE_ENABLED=false
STORAGE_GATEWAY_URL=
STORAGE_PROJECT_TOKEN=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_INTERNAL_ENDPOINT=
STORAGE_GATEWAY_TIMEOUT_SECONDS=60
