# LLM Router Environment Variables

# Application
APP_NAME=LLM Router
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-strong-random-key
MASTER_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded-key

BROWSER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXY_CIDRS=

# Database
DATABASE_URL=postgresql+asyncpg://ai_infra:ai_infra@localhost:5432/ai_infra

# Redis
REDIS_URL=redis://localhost:6379/0
# Local development may keep running without Redis. APP_ENV != development
# always fails closed before a provider call, regardless of this value.
AI_QUOTA_DEVELOPMENT_FAIL_OPEN=true
AI_QUOTA_REDIS_TIMEOUT_SECONDS=0.5
AI_QUOTA_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_QUOTA_RESERVATION_TTL_SECONDS=3456000

# API Key cache TTL (seconds)
API_KEY_CACHE_TTL=60

# DLP Stream Scanner
DLP_STREAM_BUFFER_WINDOW=4096
DLP_STREAM_FLUSH_TIMEOUT_MS=200

# Fixed platform tool executor (never runs user-provided code)
TOOL_EXECUTOR_URL=http://localhost:8020
TOOL_EXECUTOR_TOKEN=tool-executor-dev-token-change-in-production
TOOL_EXECUTOR_TIMEOUT_SECONDS=120
TOOL_EXECUTOR_QUEUE_WAIT_SECONDS=300

MODULE_SAAS_ORIGIN=https://ai-platform.staging.zhuojianai.com
AGENT_GLOBAL_CONCURRENCY=12
AGENT_USER_CONCURRENCY=2
AGENT_QUEUE_MAX=100
AGENT_QUEUE_WAIT_SECONDS=300
AGENT_LEASE_SECONDS=60
AGENT_HEARTBEAT_SECONDS=15
AGENT_MAX_STEPS=24

# Authenticated original file bytes. The browser chooses a renderer by suffix.
# Empty allowlist enables all organizations.
ORIGINAL_PREVIEW_ENABLED=false
ORIGINAL_PREVIEW_ORG_ALLOWLIST=

# OpenAI-compatible vision content blocks and Images API. Keep allowlists scoped
# during staging; an empty allowlist enables the feature for every organization.
MULTIMODAL_VISION_ENABLED=true
MULTIMODAL_VISION_ORG_ALLOWLIST=aifabei
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_ORG_ALLOWLIST=aifabei
MODEL_GATEWAY_ENABLED=true
MODEL_GATEWAY_ORG_ALLOWLIST=aifabei

# Workspace binary object storage through ZhuoJian Storage Gateway.
# Keep disabled for local-only development. STORAGE_PROJECT_TOKEN is issued
# per GitHub project by the platform provisioner; never place an OSS AccessKey here.
WORKSPACE_OBJECT_STORAGE_ENABLED=false
STORAGE_GATEWAY_URL=
STORAGE_PROJECT_TOKEN=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_INTERNAL_ENDPOINT=
STORAGE_ACCELERATE_ENDPOINT=https://oss-accelerate.aliyuncs.com
STORAGE_GATEWAY_TIMEOUT_SECONDS=60

# Staging-wide workspace governance. There is intentionally no organization
# allowlist. Disable only as an emergency deployment-wide rollback.
WORKSPACE_HYBRID_UPLOAD_ENABLED=true
WORKSPACE_MAX_FILE_BYTES=5368709120
WORKSPACE_AI_PARSE_MAX_BYTES=104857600
WORKSPACE_PROXY_UPLOAD_MAX_BYTES=1048576
WORKSPACE_UPLOAD_SESSION_TTL_SECONDS=86400
WORKSPACE_WEBOFFICE_ENABLED=false
WORKSPACE_WEBOFFICE_MAX_BYTES=209715200
WORKSPACE_PDF_DIRECT_PREVIEW_MAX_BYTES=20971520
WORKSPACE_PREVIEW_JOB_POLL_SECONDS=1
WORKSPACE_PREVIEW_JOB_LEASE_SECONDS=900
WORKSPACE_TRASH_RETENTION_DAYS=30
